platform :ios, '16.0'
use_frameworks!

def shared_pods
  pod 'Shared', :path => '../shared'
  pod 'Firebase/CoreOnly'
  pod 'Firebase/Auth'
  pod 'Firebase/Firestore'
  pod 'Firebase/Messaging'
  pod 'Firebase/Functions'
end

target 'PulseLinkFree' do
  shared_pods
  pod 'Google-Mobile-Ads-SDK'
end

target 'PulseLinkPro' do
  shared_pods
end

target 'BeaconFree' do
  shared_pods
  pod 'Google-Mobile-Ads-SDK'
end

target 'BeaconPro' do
  shared_pods
end

# Remove KMP-generated build phase; we prebuild in CI via generateDummyFramework.
post_install do |installer|
  # Align all pods to iOS 16 to silence deployment target warnings on Xcode 16.
  installer.pods_project.targets.each do |t|
    t.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
    end
  end
  installer.pods_project.targets.each do |t|
    next unless t.name == 'Shared'
    t.build_phases.each do |phase|
      if phase.respond_to?(:display_name) && phase.display_name.include?('Build Shared')
        t.build_phases.delete(phase)
      end
    end
  end
end
