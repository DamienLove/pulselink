<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <stroke android:width="3dp" android:color="#00F3FF" />
            <solid android:color="#0C0F16" />
        </shape>
    </item>
    <item android:left="3dp" android:right="3dp" android:top="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="13dp" />
            <stroke android:width="1dp" android:color="#E000FF" />
            <solid android:color="#0B0E15" />
        </shape>
    </item>
</layer-list>
