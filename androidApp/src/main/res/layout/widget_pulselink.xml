<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp"
    android:background="@android:color/transparent">

    <RelativeLayout
        android:id="@+id/widget_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_card_frame"
        android:padding="10dp">

        <!-- Header -->
        <LinearLayout
            android:id="@+id/widget_header"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/widget_status_pill"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/widget_status_dot_green"
                android:contentDescription="@string/app_name" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/widget_settings_button"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:padding="3dp"
                android:src="@drawable/widget_ic_settings"
                android:tint="@color/widget_gold_light"
                android:contentDescription="@string/widget_open_settings" />
        </LinearLayout>

        <!-- Contact list -->
        <LinearLayout
            android:id="@+id/widget_contacts"
            android:layout_width="377dp"
            android:layout_height="646dp"
            android:layout_alignTop="@+id/widget_center_overlay"
            android:layout_alignParentStart="true"
            android:layout_marginStart="0dp"
            android:layout_marginTop="-215dp"
            android:orientation="vertical">

            <include layout="@layout/widget_row_contact_1" />

            <include layout="@layout/widget_row_contact_2" />

            <include layout="@layout/widget_row_contact_3" />

            <include layout="@layout/widget_row_contact_4" />

            <include layout="@layout/widget_row_contact_5" />

            <include layout="@layout/widget_row_contact_6" />

            <include layout="@layout/widget_row_contact_7" />

            <include layout="@layout/widget_row_contact_8" />

            <include layout="@layout/widget_row_contact_9" />

            <include layout="@layout/widget_row_contact_0" />


        </LinearLayout>

        <!-- Center overlay -->
        <FrameLayout
            android:id="@+id/widget_center_overlay"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true">

            <ImageView
                android:id="@+id/widget_center_glow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_center_glow_gold" />

            <ImageView
                android:id="@+id/widget_logo"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_gravity="center"
                android:padding="12dp"
                android:src="@drawable/ic_logo"
                android:contentDescription="@string/app_name" />

            <!-- Clock hands -->
            <View
                android:id="@+id/widget_hand_hour"
                android:layout_width="4dp"
                android:layout_height="70dp"
                android:layout_gravity="center"
                android:background="@drawable/widget_hand" />

            <View
                android:id="@+id/widget_hand_minute"
                android:layout_width="3dp"
                android:layout_height="90dp"
                android:layout_gravity="center"
                android:background="@drawable/widget_hand_light" />

            <!-- Invisible trigger -->
            <TextView
                android:id="@+id/widget_emergency_button"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent" />

            <TextView
                android:id="@+id/widget_tooltip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="6dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:background="@drawable/widget_tooltip_bg"
                android:text="@string/widget_tap_to_arm"
                android:textColor="@android:color/black"
                android:textStyle="bold"
                android:textSize="10sp"
                android:visibility="visible" />
        </FrameLayout>
    </RelativeLayout>
</RelativeLayout>
