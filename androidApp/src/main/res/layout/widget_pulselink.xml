<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:padding="8dp">

    <RelativeLayout
        android:id="@+id/widget_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_panel_background"
        android:padding="14dp">

        <!-- Header -->
        <LinearLayout
            android:id="@+id/widget_header"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/widget_status_pill"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/widget_status_dot_green"
                android:contentDescription="@string/app_name" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/widget_settings_button"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:padding="3dp"
                android:src="@drawable/widget_ic_settings"
                android:tint="@color/widget_gold_light"
                android:contentDescription="@string/widget_open_settings" />
        </LinearLayout>

        <!-- Contact list -->
        <LinearLayout
            android:id="@+id/widget_contacts"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:layout_alignParentTop="true">

            <include layout="@layout/widget_row_contact_1" />

            <include layout="@layout/widget_row_contact_2" />

            <include layout="@layout/widget_row_contact_3" />

            <include layout="@layout/widget_row_contact_4" />

            <include layout="@layout/widget_row_contact_5" />
        </LinearLayout>

        <!-- Center overlay -->
        <FrameLayout
            android:id="@+id/widget_center_overlay"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true">

            <ImageView
                android:id="@+id/widget_center_glow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_center_glow_gold" />

            <ImageView
                android:id="@+id/widget_logo"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="center"
                android:padding="6dp"
                android:src="@drawable/widget_logo"
                android:contentDescription="@string/app_name" />

            <!-- Clock hands -->
            <View
                android:id="@+id/widget_hand_hour"
                android:layout_width="4dp"
                android:layout_height="70dp"
                android:layout_gravity="center"
                android:background="@drawable/widget_hand" />

            <View
                android:id="@+id/widget_hand_minute"
                android:layout_width="3dp"
                android:layout_height="90dp"
                android:layout_gravity="center"
                android:background="@drawable/widget_hand_light" />

            <!-- Invisible trigger -->
            <TextView
                android:id="@+id/widget_emergency_button"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent" />

            <TextView
                android:id="@+id/widget_tooltip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="-8dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:background="@drawable/widget_tooltip_bg"
                android:text="@string/widget_tap_to_arm"
                android:textColor="@android:color/black"
                android:textStyle="bold"
                android:textSize="10sp"
                android:visibility="visible" />
        </FrameLayout>
    </RelativeLayout>
</RelativeLayout>
