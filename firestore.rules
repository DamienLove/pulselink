rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isDeviceOwner(deviceId) {
      return get(/databases/$(database)/documents/devices/$(deviceId)).data.uid == request.auth.uid;
    }

    function isSubscriptionFieldChange() {
      return request.resource != null &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(["premiumSubscriptionStatus","premiumSubscriptionExpiry","tierBeforePremium","subscriptionPurchaseToken"]);
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId && !isSubscriptionFieldChange();

      match /synced_threads/{threadId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        match /messages/{messageId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }

      match /outbox/{messageId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /trustedContacts/{contactId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /deviceContacts/{contactId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /emergencyLocations/{locationId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /ringer_playlist/{songId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Allow syncing lines data which contains thread backups as well (Supports both legacy and new sync architectures)
      match /lines/{lineId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        match /threads/{threadId} {
           allow read, write: if request.auth != null && request.auth.uid == userId;

           match /messages/{messageId} {
             allow read, write: if request.auth != null && request.auth.uid == userId;
           }
        }
      }
    }

    match /public_profiles/{userId} {
      allow read: if true;
      // Security: Sentinel - Restrict writes to allowed profile fields only.
      // Prevent injection of "isAdmin", "isVerified", or large junk data.
      allow create, update: if request.auth != null && request.auth.uid == userId
                            && request.resource.data.keys().hasOnly(['ownerName', 'avatarUrl', 'avatarId', 'themePreferences', 'updatedAt']);
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Explicit device matching
    match /devices/{deviceId} {
      // Security: Only the owner can read their device mapping.
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;

      // Security: Prevent device takeover.
      // 1. Must assign to self (request.resource.data.uid == auth.uid).
      // 2. If updating, must already own it (resource.data.uid == auth.uid).
      allow write: if request.auth != null &&
                   request.resource.data.uid == request.auth.uid &&
                   (!exists(/databases/$(database)/documents/devices/$(deviceId)) || resource.data.uid == request.auth.uid);
    }

    match /users_by_phone/{phoneNumber} {
      // Security: Sentinel - Allow looking up a specific phone number (get), but deny listing all numbers (list).
      // This prevents enumerating all users in the database.
      allow get: if request.auth != null;

      // Security: Sentinel - Ensure user owns the phone number they are claiming.
      // This prevents identity spoofing where a user claims a number they don't own.
      allow create, update: if request.auth != null
                            && request.resource.data.uid == request.auth.uid
                            && request.auth.token.phone_number == phoneNumber;
      allow delete: if false;
    }

    match /callerIdCache/{phoneNumber} {
      // Security: Sentinel - Restrict access to single document lookups (get).
      // Prevent bulk listing/enumeration of the cache (list).
      allow get: if request.auth != null;
      // Security: Sentinel - Prevent cache poisoning.
      // Clients cannot be trusted to write shared global cache data.
      // Writes must be handled by a trusted backend (Cloud Function).
      allow write: if false;
    }

    match /linkChannels/{channelId} {
       // Security: Deny access to the channel container document to prevent deletion/modification.
       // Clients only interact with the 'messages' subcollection.
       allow read, write: if false;

       match /messages/{messageId} {
         allow read: if request.auth != null && (
           isDeviceOwner(resource.data.receiverId) ||
           isDeviceOwner(resource.data.senderId)
         );
         // Security: Sentinel - Prevent Message Injection.
         // Enforce that the channelId matches the derived ID from sender and receiver.
         // channelId must be "ID1_ID2" (sorted).
         // This ensures users can only write to channels where their device (senderId) is a valid participant.
         allow create: if request.auth != null
                       && isDeviceOwner(request.resource.data.senderId)
                       && (
                         (request.resource.data.senderId < request.resource.data.receiverId && channelId == request.resource.data.senderId + "_" + request.resource.data.receiverId) ||
                         (request.resource.data.senderId > request.resource.data.receiverId && channelId == request.resource.data.receiverId + "_" + request.resource.data.senderId)
                       );
         allow delete: if request.auth != null && isDeviceOwner(resource.data.receiverId);
       }
    }

    match /links/{linkCode} {
      // Rendezvous: Allow getting a link by ID (knowing the secret code).
      allow get: if request.auth != null;

      // Security: Prevent enumerating all links. Only participants can list.
      allow list: if request.auth != null && request.auth.uid in resource.data.uids;

      // Security: Allow write only if joining (adding self) or updating self.
      // We ensure the user is part of the 'uids' array in the new state.
      allow write: if request.auth != null && request.auth.uid in request.resource.data.uids;
    }

    match /linkEmailInvites/{inviteId} {
      // Security: Sender creates invites.
      allow create: if request.auth != null && request.resource.data.senderUid == request.auth.uid;

      // Security: Sender or intended Recipient (by email) can read.
      // Note: Recipient query must filter by 'targetEmailLowercase'.
      allow read: if request.auth != null && (
        resource.data.senderUid == request.auth.uid ||
        (request.auth.token.email != null && resource.data.targetEmailLowercase == request.auth.token.email)
      );

      // Security: Cleanup after acceptance.
      allow delete: if request.auth != null && (
        resource.data.senderUid == request.auth.uid ||
        (request.auth.token.email != null && resource.data.targetEmailLowercase == request.auth.token.email)
      );
    }

    match /relayAlerts/{alertId} {
      // Security: Force usage of 'alertRelay' Cloud Function for validation.
      allow read, write: if false;
    }

    match /themes_public/{themeId} {
      allow read: if true;
      // Security: Sentinel - Prevent public theme poisoning.
      // Users cannot be trusted to approve their own themes.
      // Moderation must happen via 'themes_submissions' and a backend function.
      allow write: if false;
    }

    match /themes_submissions/{themeId} {
      allow read: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow create: if request.auth != null &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.status == "pending";
      allow update, delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }
  }
}
